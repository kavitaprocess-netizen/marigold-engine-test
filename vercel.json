{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    },
    {
      "src": "advisor-review/questionnaire.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/questionnaire",
      "dest": "/server.js"
    },
    {
      "src": "/advisor",
      "dest": "/server.js"
    },
    {
      "src": "/brand.css",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/",
      "dest": "/server.js"
    }
  ]
}
{
  "version": 2,
  "builds": [
    { "src": "server.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/", "dest": "/server.js" },
    { "src": "/questionnaire", "dest": "/server.js" },
    { "src": "/advisor", "dest": "/server.js" },
    { "src": "/brand.css", "dest": "/server.js" },
    { "src": "/api/(.*)", "dest": "/server.js" }
  ]
}
